# Copy this file to .env and configure your Anthropic credentials.
# Live mode is enabled by default for users with an Anthropic API key.
# For offline development or automated tests without a key, set CLAUDE_MOCK_MODE=true.
CLAUDE_MOCK_MODE=false
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096
