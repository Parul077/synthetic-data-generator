# Copy this file to .env and configure your Anthropic credentials.
# Live mode is enabled by default for users with an Anthropic API key.
# For offline development or automated tests without a key, set CLAUDE_MOCK_MODE=true.
CLAUDE_MOCK_MODE=false
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# (Optional) ANTHROPIC_MAX_TOKENS: Output token limit override.
# When omitted, the system dynamically allocates the maximum capacity supported by your model
# (e.g. 8,192 for Claude 3.5 Sonnet, up to 64,000 for Claude 3.7 Sonnet) and seamlessly resumes
# long-running tasks using automatic continuation without restarting or losing progress.
# ANTHROPIC_MAX_TOKENS=8192

